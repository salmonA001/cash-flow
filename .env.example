# ─────────────────────────────────────────────────────────────────────────────
# Cash Flow Engine OS — environment configuration
# Copy to .env and replace EVERY "change-me" value. Never commit .env.
# Generate secrets with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of the app (Caddy serves web + API on this origin). Used for CSRF checks and links.
APP_DOMAIN=localhost
APP_URL=http://localhost:3000
# "true" in production (HTTPS). Must be "false" for plain-HTTP local development.
COOKIE_SECURE=false

# ── PostgreSQL ──
POSTGRES_USER=cfe
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=cfe
DATABASE_URL=postgresql://cfe:change-me-postgres@postgres:5432/cfe?schema=public

# ── Redis (queues + cache) ──
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379/0

# ── Application secrets ──
# 32+ random characters
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
# 32 random bytes, base64 — encrypts integration tokens at rest (AES-256-GCM). Losing it = reconnect integrations.
ENCRYPTION_KEY=change-me-base64-32-bytes

# ── MinIO object storage ──
# Root credentials: administration only (console, bucket policies). Not given to the app.
MINIO_ROOT_USER=cfe-admin
MINIO_ROOT_PASSWORD=change-me-minio-root
# Application credentials: a separate MinIO user with read/write on the app buckets only
# (created by infrastructure/minio/init.sh).
MINIO_ACCESS_KEY=cfe-app
MINIO_SECRET_KEY=change-me-minio-app
MINIO_ENDPOINT=http://minio:9000
# Browser-reachable S3 endpoint used to sign short-lived download URLs.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
FILES_DOMAIN=files.localhost

# ── Shopify (custom app) ──
SHOPIFY_CLIENT_ID=change-me
SHOPIFY_CLIENT_SECRET=change-me

# ── Printful ──
# Shared secret appended to the Printful webhook URL (?token=...). 24+ characters.
PRINTFUL_WEBHOOK_SECRET=change-me-printful-webhook-secret

# ── Email (download link delivery) ──
# Production: your SMTP provider, e.g. smtp://user:pass@smtp.provider.com:587
# Local dev: mailpit from docker-compose.dev.yml → smtp://localhost:1025 (inbox UI on :8025)
SMTP_URL=smtp://user:change-me@smtp.example.com:587
MAIL_FROM="Cash Flow Engine <downloads@example.com>"

# ── Web → API (server-side proxy target) ──
API_INTERNAL_URL=http://api:4000

# ── First-run seed (owner account) ──
SEED_ORG_NAME="Cash Flow Engine"
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=change-me-at-least-12-chars

# ── Monitoring ──
GRAFANA_ADMIN_PASSWORD=change-me-grafana
