{
  "name": "@cfe/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next dev -p 3000",
    "build": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next build",
    "start": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "echo 'UI is covered by Playwright: pnpm test:e2e'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cfe/shared-types": "workspace:*",
    "@cfe/validation": "workspace:*",
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.544.0",
    "next": "15.5.28",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.65.0",
    "recharts": "3.2.1",
    "sonner": "2.0.7",
    "swr": "2.3.6",
    "tailwind-merge": "3.3.1",
    "zod": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3"
  }
