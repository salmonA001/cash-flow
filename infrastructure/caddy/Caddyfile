# The whole system is served by this one server.

# Web app, with the API on the same origin (first-party SameSite=Strict session cookies).
{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# 600 MB covers the largest digital product upload (500 MB) plus multipart overhead.
	request_body {
		max_size 600MB
	}

	handle /api/* {
		reverse_proxy api:4000
	}
	handle /health {
		reverse_proxy api:4000
	}
	# Everything else is the web app. The API's /metrics (scraped by Prometheus on the internal
	# network) is never routed here.
	handle {
		reverse_proxy web:3000
	}
}

# Object storage: S3 API only, for short-lived presigned URLs.
# The MinIO console (port 9001) is never exposed.
{$FILES_DOMAIN} {
	reverse_proxy minio:9000
}
