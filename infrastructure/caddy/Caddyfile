# The web app is hosted on Vercel (app domain). This VPS serves the API and object storage.

# API: called directly by the browser from the app domain (same site → session cookies work).
{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# 600 MB covers the largest digital product upload (500 MB) plus multipart overhead.
	request_body {
		max_size 600MB
	}

	handle /api/* {
		reverse_proxy api:4000
	}
	handle /health {
		reverse_proxy api:4000
	}
	# Everything else — including /metrics, scraped by Prometheus on the internal network — is not exposed.
	handle {
		respond 404
	}
}

# Object storage: S3 API only, for short-lived presigned URLs.
# The MinIO console (port 9001) is never exposed.
{$FILES_DOMAIN} {
	reverse_proxy minio:9000
}
