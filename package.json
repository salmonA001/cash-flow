{
  "name": "cash-flow-engine",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** run build && pnpm -r --filter ./apps/** run build",
    "build:packages": "pnpm -r --filter ./packages/** run build",
    "dev:api": "pnpm --filter @cfe/api dev",
    "dev:worker": "pnpm --filter @cfe/worker dev",
    "dev:scheduler": "pnpm --filter @cfe/worker dev:scheduler",
    "dev:web": "pnpm --filter @cfe/web dev",
    "db:generate": "pnpm --filter @cfe/database generate",
    "db:migrate": "pnpm --filter @cfe/database migrate:dev",
    "db:deploy": "pnpm --filter @cfe/database migrate:deploy",
    "db:seed": "pnpm --filter @cfe/database seed",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @cfe/web test:e2e"
  }
}
